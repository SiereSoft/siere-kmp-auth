{
  "realm": "siere",
  "enabled": true,
  "displayName": "Siere KMP Auth sample",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "siere-jvm-oidc",
      "name": "Siere JVM OIDC sample",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://127.0.0.1/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "profile",
        "email"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "siere-android-oidc",
      "name": "Siere Android OIDC sample",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "dev.siere.auth.sample://oauth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "profile",
        "email"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Siere",
      "lastName": "Demo",
      "email": "demo@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "demo-password",
          "temporary": false
        }
      ]
    }
  ]
}
